<template b-props="name, role = 'Member'">
  <strong>[[ name ]]</strong>
  <span class="role">[[ role ]]</span>
</template>

<style>
  self { display: flex; gap: 10px; align-items: center; margin: 8px 0; }
  .role { padding: 2px 10px; border-radius: 999px; background: #2f6bff; color: white; font-size: 13px; }
</style>
