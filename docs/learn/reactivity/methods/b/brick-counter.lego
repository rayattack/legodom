<template>
  <p class="count">[[ count ]] / [[ limit ]] bricks</p>
  <button @click="add(1)">+1</button>
  <button @click="add(5)">+5</button>
  <button @click="reset()">Reset</button>
</template>

<script>
export default {
  count: 0,
  limit: 20,

  add(amount) {
    this.count = Math.min(this.count + amount, this.limit);
  },

  reset() {
    this.count = 0;
  }
}
</script>

<style>
  .count { font-size: 28px; font-weight: 800; }
  button { padding: 8px 14px; border-radius: 8px; border: 2px solid #14161f; background: #ffd43b; cursor: pointer; }
</style>
