<template b-shadow="false" b-props="tone: String = 'neutral', count: Number = 0">
  <span class="badge badge--[[tone]]">
    <slot></slot>
    <b b-if="count > 0" class="badge__count">[[count]]</b>
  </span>
</template>

<style>
  self {
    display: inline-block;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .badge--neutral {
    background: #eef1f6;
    color: #46506b;
  }

  .badge--brand {
    background: #e5edff;
    color: #2f6df6;
  }

  .badge--warn {
    background: #fdf0d5;
    color: #8a5a00;
  }

  .badge__count {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
</style>

<story name="Brand" args="{ tone: 'brand', count: 4 }">Unread</story>
<story name="Warning" args="{ tone: 'warn' }">Needs review</story>
