{
  "name": "lego-dom",
  "version": "2.1.1-alpha",
  "license": "MIT",
  "description": "A feature-rich web components + SFC frontend framework",
  "main": "dist/main.js",
  "module": "dist/lego.mjs",
  "type": "module",
  "files": [
    "dist",
    "src",
    "vite-plugin.js",
    "parse-lego.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/lego.mjs",
      "require": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./vite-plugin": "./vite-plugin.js",
    "./parse-lego": "./parse-lego.js"
  },
  "keywords": [
    "framework",
    "sfc",
    "components",
    "lego",
    "legokit"
  ],
  "author": "Tersoo Ortserga",
  "scripts": {
    "test": "vitest run",
    "build": "node build.js",
    "clean": "rm -rf dist",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "jsdom": "^22.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rayattack/legodom.git"
  }
}