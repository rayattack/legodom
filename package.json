{
  "name": "lego-dom",
  "version": "2.1.8",
  "license": "MIT",
  "description": "A feature-rich web components + SFC frontend framework",
  "main": "dist/lego.min.js",
  "module": "dist/lego.mjs",
  "types": "./dist/lego.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "studio",
    "vite-plugin.js"
  ],
  "bin": {
    "lego-studio": "studio/bin/lego-studio.js"
  },
  "exports": {
    ".": {
      "import": "./dist/lego.mjs",
      "require": "./dist/lego.min.js",
      "default": "./dist/lego.min.js"
    },
    "./server": {
      "import": "./dist/lego.server.mjs",
      "types": "./dist/lego.server.d.ts"
    },
    "./vite-plugin": "./vite-plugin.js",
    "./studio": "./studio/src/index.js",
    "./studio/preview": "./studio/src/preview/runtime.js"
  },
  "keywords": [
    "framework",
    "sfc",
    "components",
    "lego",
    "legokit"
  ],
  "author": "Tersoo Ortserga",
  "scripts": {
    "test": "vitest run",
    "build": "node build.js",
    "studio": "node studio/bin/lego-studio.js",
    "studio:snap": "node studio/bin/lego-studio.js snap",
    "studio:check": "node studio/bin/lego-studio.js snap --check",
    "studio:graph": "node studio/bin/lego-studio.js graph",
    "clean": "rm -rf dist",
    "docs:dev": "vite --config site/vite.config.js",
    "docs:build": "vite build --config site/vite.config.js && node site/scripts/prerender.js",
    "docs:preview": "vite preview --config site/vite.config.js",
    "docs:check": "node site/scripts/check-links.js"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.27.2",
    "jsdom": "^22.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-container": "^4.0.0",
    "shiki": "^4.6.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rayattack/legodom.git"
  }
}
